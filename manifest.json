{
  "manifest_version": 3,
  "name": "ClearAndReload",
  "version": "1.3.0",
  "description": "Chromium extension to clear all data for the current site and reload. Useful for developers and testers.",
  "permissions": [
    "browsingData",
    "cookies",
    "history",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Clear site data & reload",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Shift+Alt+F"
      }
    }
  }
}
